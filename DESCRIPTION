Package: crownsegmentr
Title: Tree Crown Segmentation in Airborne LiDAR Data
Version: 0.0.0.9000
Authors@R: c(
    person("Leon", "Steinmeier", , "Leon.Steinmeier@posteo.net", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-9040-636X", "Created the package as part of his master thesis.")),
